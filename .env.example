# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ENABLE_DOCS=true
ENABLE_SWAGGER_DOCS=true

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgres://betty:betty_secret_pass@localhost:5432/betty_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=betty
POSTGRES_PASSWORD=betty_secret_pass
POSTGRES_DB=betty_db

# Dragonfly Cache (Redis-compatible)
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6380
DRAGONFLY_PASSWORD=dragonfly_secret_pass

# MQTT Broker (EMQX)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=betty-api-server
MQTT_USERNAME=betty_system_admin
MQTT_PASSWORD=betty_system_secret

# Security & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_32chars!
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Betty PaaS <onboarding@resend.dev>"

# Internationalization
DEFAULT_LOCALE=es
FALLBACK_LOCALE=en
